<h1><strong>Books</strong></h1>
<table border="0">
  <thead>
    <tr>
      <th>Title</th>
      <th>body</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td><%= book.title %></td>
        <td><%= book.body %></td>
        <td>
          <%= link_to "Show", book_path(book) %>
          <%= link_to "Edit", edit_book_path(book) %>
          <%= link_to "Destroy", book_path(book), method: :delete, data: { turbo_method: :delete, turbo_confirm: "Are you sure ?"} %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>


<h2>New book</h2>
<% if @book.errors.any? %>
  <div class= "error-box">
    <div class= "error-title">
      <%= @book.errors.count %>errors prohibited this book from being saved:
    </div>
    <ul>
      <% @book.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>    

<%= form_with model: @book do |f| %>
  <div class= field>
    <label>Title</label>
    <%= f.text_field :title %>
  </div>
  <div class= field>
    <label>Body</label>
    <%= f.text_area :body %>
  </div>
  <%= f.submit 'Create Book'%>
<% end %>
