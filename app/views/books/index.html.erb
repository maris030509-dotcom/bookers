<h1><strong>Books</strong></h1>
<%= @book.each do |book| %>

  <p><strong>Title<strong></p>
  <span><%= book.title %></span>

  <p><strong>Body<strong></p>
  <span><%= book.body %></span>
  
  
<%= link_to "show", show_book_path(@book.id) %>
<%= link_to "Edit", edit_book_path(@book.id) %>
<%= link_to "destroy", destroy_book_path(@book.id), data: { turbo_method: :delete, turbo_confirm: "Are you sure ?"} %>

<% end %>